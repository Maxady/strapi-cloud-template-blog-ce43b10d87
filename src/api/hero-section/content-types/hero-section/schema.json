{
  "kind": "singleType",
  "collectionName": "hero_section",
  "info": {
    "singularName": "hero-section",
    "pluralName": "hero-sections",
    "displayName": "Hero Section",
    "description": "Configuration de la section Hero de la page d'accueil"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "badge": {
      "type": "string",
      "required": true,
      "default": "CABINET DE COACHING · DAKAR, SENEGAL"
    },
    "description": {
      "type": "text",
      "required": true
    },
    "titre": {
      "type": "string",
      "required": true
    },
    "sousTitre": {
      "type": "string",
      "required": true
    },
    "backgroundImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "stats": {
      "type": "json",
      "description": "Stats affichées (experience, certifications, scope)",
      "required": true
    },
    "boutons": {
      "type": "json",
      "description": "Configuration des boutons CTA",
      "required": true
    }
  }
}
